# ── File Tools ──────────────────────────────────────────────────────
# Root directory the agent is allowed to operate in (cannot escape this path)
FILE_TOOLS_ROOT=~/Documents

# ── Jira (optional) ─────────────────────────────────────────────────
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=your_api_token_here

# ── News RSS (optional) ─────────────────────────────────────────────
# Comma-separated RSS feed URLs per category — defaults are set in news_tools.py
# NEWS_FEEDS_TECHNOLOGY=https://feeds.example.com/tech
# NEWS_FEEDS_GENERAL=https://feeds.example.com/general

# ── Blog (optional) ─────────────────────────────────────────────────
# BLOG_REPO_PATH=~/path/to/your/jekyll-blog
